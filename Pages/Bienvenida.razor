@page "/"
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject NavigationManager Navigation
<div class="bienvenida-card">

    <img src="/img/mano-mundo.png"
         alt="Acogida 2.0"
         class="logo-principal" />

    <h1>Bienvenido a Acogida 2.0</h1>

    <p class="subtitulo">
        Accede fácilmente a los servicios que necesitas.
    </p>
    <div class="idiomas-bienvenida">

        <button class="btn-idioma"
                @onclick='() => ProbarIdioma("Bienvenido a Acogida", "es-ES")'>
            ES
        </button>

        <button class="btn-idioma"
                @onclick='() => ProbarIdioma("مرحبا بكم", "ar-SA")'>
            AR
        </button>

        <button class="btn-idioma"
                @onclick='() => ProbarIdioma("Welcome to Acogida", "en-GB")'>
            EN
        </button>

        <button class="btn-idioma"
                @onclick='() => ProbarIdioma("Bienvenue dans Acogida", "fr-FR")'>
            FR
        </button>

    </div>
    <a href="/home" class="btn-primary boton-empezar">
        Comenzar
    </a>
    <p>© Corp.Diablo 2026. Todos los derechos reservados.</p>
</div>
@code {

    private void Comenzar()
    {
        Navigation.NavigateTo("/inicio");
    }

    private async Task ProbarIdioma(string texto, string idioma)
    {
        string js = $@"
            window.speechSynthesis.cancel();
            let u = new SpeechSynthesisUtterance('{texto}');
            u.lang = '{idioma}';
            window.speechSynthesis.speak(u);
        ";

        await JS.InvokeVoidAsync("eval", js);
    }

}
