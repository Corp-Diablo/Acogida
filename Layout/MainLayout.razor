@inherits LayoutComponentBase

<div class="layout-principal">

    <div class="sidebar">

        <div class="language-selector">

            <img src="img/banderas/es.png"
                 alt="Español"
                 class="bandera" />

            <img src="img/banderas/ca.png"
                 alt="Català"
                 class="bandera" />

            <img src="img/banderas/en.png"
                 alt="English"
                 class="bandera" />

            <img src="img/banderas/ar.png"
                 alt="العربية"
                 class="bandera" />

            <img src="img/banderas/fr.png"
                 alt="Français"
                 class="bandera" />

        </div>

    </div>

    <main class="contenido">
        @Body
    </main>

</div>