@page "/"
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject NavigationManager Navigation
<div class="pantalla-bienvenida">

    <div class="logo-bienvenida">
        🌍
    </div>

    <h1 class="titulo-bienvenida">
        ACOGIDA
    </h1>

    <p class="texto-bienvenida">
        Comunicación básica y ayuda para personas recién llegadas
    </p>

    <div class="idiomas-bienvenida">

        <button class="btn-idioma"
                @onclick='() => ProbarIdioma("Bienvenido a Acogida", "es-ES")'>
            ES
        </button>

        <button class="btn-idioma"
                @onclick='() => ProbarIdioma("مرحبا بكم", "ar-SA")'>
            AR
        </button>

        <button class="btn-idioma"
                @onclick='() => ProbarIdioma("Welcome to Acogida", "en-GB")'>
            EN
        </button>

        <button class="btn-idioma"
                @onclick='() => ProbarIdioma("Bienvenue dans Acogida", "fr-FR")'>
            FR
        </button>

    </div>


    <button class="btn-siguiente" @onclick="Comenzar">
        COMENZAR
    </button>

    <div class="copyright">
        © 2026 Corp.Diablo
    </div>
@code {

    private void Comenzar()
    {
        Navigation.NavigateTo("/inicio");
    }

    private async Task ProbarIdioma(string texto, string idioma)
    {
        string js = $@"
            window.speechSynthesis.cancel();
            let u = new SpeechSynthesisUtterance('{texto}');
            u.lang = '{idioma}';
            window.speechSynthesis.speak(u);
        ";

        await JS.InvokeVoidAsync("eval", js);
    }

}
</div>
