@page "/"
@inject NavigationManager Navigation

<div class="welcome-container">

    <div class="welcome-card">

        <img src="img/icons/mano-mundo.png"
             alt="Acogida"
             class="welcome-logo" />

        <h1 class="welcome-title">
            Acogida
        </h1>

        <p class="welcome-subtitle">
            Información básica para ayudarte en tu llegada.
        </p>

        <div class="privacy-section">

            <input type="checkbox"
                   id="accept"
                   @bind="Aceptado" />

            <label for="accept">
                He leído y acepto la política de privacidad y el aviso legal.
            </label>

        </div>

        <button class="btn-start"
                disabled="@(!Aceptado)"
                @onclick="Entrar">
            Comenzar
        </button>

        <div class="version-text">
            Versión 1.0
        </div>

    </div>

</div>

@code {

    private bool Aceptado;

    private void Entrar()
    {
        Navigation.NavigateTo("/inicio");
    }

}